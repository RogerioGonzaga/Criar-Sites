# Copie este arquivo para .env.local e preencha o que for usar.
# Depois de alterar qualquer valor, rode `npm run build` novamente.

# Endereço público do site, sem barra no final (usado no SEO, sitemap e compartilhamento)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# WhatsApp com código do país e DDD, apenas dígitos (ex.: 55 + DDD + número)
NEXT_PUBLIC_WHATSAPP=

# E-mail público de contato (opcional)
NEXT_PUBLIC_EMAIL=

# --- Envio do formulário de orçamento (escolha UMA opção) ---

# Opção 1: webhook que recebe um POST em JSON (Formspree, Make, Zapier, n8n, Google Apps Script...)
FORM_WEBHOOK_URL=
# Opcional: token enviado como "Authorization: Bearer <token>"
FORM_WEBHOOK_TOKEN=

# Opção 2: envio por e-mail pela Resend (https://resend.com)
RESEND_API_KEY=
ORCAMENTO_EMAIL_PARA=
ORCAMENTO_EMAIL_DE=
